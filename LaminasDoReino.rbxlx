	HitboxHeight = 6,

	BlockReduction = 0.75, -- bloqueio reduz 75% do dano
	BlockStaminaCost = 15,
	BlockSpeedMultiplier = 0.5,
	ParryWindow = 0.3, -- bloquear logo antes do golpe = aparar (parry)
	ParryStun = 1.2,
	GuardBreakStun = 1.0,

	StaminaMax = 100,
	StaminaRegen = 22, -- por segundo
	StaminaRegenDelay = 1,

	DashCost = 25,
