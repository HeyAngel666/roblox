    <Item class="StarterPlayerScripts" referent="3463">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="3464">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[--[[
	LÂMINAS DO REINO - Cliente
	Inicia interface, controles de combate e efeitos visuais.
]]

local EffectsController = require(script:WaitForChild("EffectsController"))
local UIController = require(script:WaitForChild("UIController"))
local CombatController = require(script:WaitForChild("CombatController"))

EffectsController.Init()
UIController.Init()
CombatController.Init()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="3465">
          <Properties>
            <string name="Name">CombatController</string>
            <string name="Source"><![CDATA[--[[
	CombatController
	Controles do jogador:
	  Clique / Toque  = Atacar (combo de 3 golpes)
	  F               = Bloquear (segurar) — bloqueie na hora certa para PARRY
	  Q               = Esquiva
	  R               = Habilidade especial da espada
	No celular aparecem botões na tela. No controle: L2, B e Y.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local C = Config.Combat

local CombatController = {}

local currentTool: Tool? = nil
local toolConnection: RBXScriptConnection? = nil
local blocking = false
local lastDash = 0

local function getCharacterParts()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

local function setBlocking(state: boolean)
	if state and not currentTool then
		return
	end
	if blocking == state then
		return
	end
	blocking = state
	Remotes.Block:FireServer(state)
end

local function dash()
	local character, humanoid, root = getCharacterParts()
	if not character or not humanoid or not root then
		return
	end
	local now = os.clock()
	if now - lastDash < C.DashCooldown or blocking or character:GetAttribute("Stunned") then
		return
	end
	if (player:GetAttribute("Stamina") or 0) < C.DashCost then
		return
	end
	lastDash = now

	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = root.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.01 then
		return
	end
	direction = direction.Unit

	Remotes.Dash:FireServer()

	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * C.DashSpeed
	velocity.MaxForce = math.huge
	velocity.Parent = root

	task.delay(C.DashDuration, function()
		velocity:Destroy()
		attachment:Destroy()
	end)
end

local function special()
	local character = getCharacterParts()
	if not character or not currentTool or blocking then
		return
	end
	Remotes.Special:FireServer()
end

local function watchTool(tool: Tool)
	if not tool:GetAttribute("SwordId") then
		return
	end
	currentTool = tool
	if toolConnection then
		toolConnection:Disconnect()
	end
	toolConnection = tool.Activated:Connect(function()
		if not blocking then
			Remotes.Attack:FireServer()
		end
	end)
end

local function onCharacterAdded(character: Model)
	currentTool = nil
	blocking = false
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			watchTool(child)
		end
	end)
	character.ChildRemoved:Connect(function(child)
		if child == currentTool then
			currentTool = nil
			if toolConnection then
				toolConnection:Disconnect()
				toolConnection = nil
			end
			if blocking then
				setBlocking(false)
			end
		end
	end)
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			watchTool(child)
		end
	end
end

function CombatController.Init()
	player.CharacterAdded:Connect(onCharacterAdded)
	if player.Character then
		onCharacterAdded(player.Character)
	end

	ContextActionService:BindAction("SwordBlock", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			setBlocking(true)
		elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
			setBlocking(false)
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonL2)

	ContextActionService:BindAction("SwordDash", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			dash()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonB)

	ContextActionService:BindAction("SwordSpecial", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			special()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonY)

	-- Botões de celular
	ContextActionService:SetTitle("SwordBlock", "Bloq")
	ContextActionService:SetTitle("SwordDash", "Esquiva")
	ContextActionService:SetTitle("SwordSpecial", "Especial")
	ContextActionService:SetPosition("SwordBlock", UDim2.new(1, -170, 1, -150))
	ContextActionService:SetPosition("SwordDash", UDim2.new(1, -230, 1, -95))
	ContextActionService:SetPosition("SwordSpecial", UDim2.new(1, -115, 1, -205))

	Remotes.Knockback.OnClientEvent:Connect(function(velocity)
		if typeof(velocity) ~= "Vector3" then
			return
		end
		local _, _, root = getCharacterParts()
		if root then
			(root :: BasePart).AssemblyLinearVelocity = velocity
		end
	end)
end

return CombatController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3466">
          <Properties>
            <string name="Name">EffectsController</string>
            <string name="Source"><![CDATA[--[[
	EffectsController
	Efeitos visuais criados só no cliente (mais suaves e sem custo de rede):
	faíscas de acerto, números de dano, anéis de habilidade, raios,
	aviso de ataque do chefe, subida de nível...
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local player = Players.LocalPlayer

local EffectsController = {}

local fxFolder: Folder

local SLASH_SOUND = "rbxasset://sounds/swordslash.wav"
local LUNGE_SOUND = "rbxasset://sounds/swordlunge.wav"

local function tween(instance: Instance, seconds: number, properties, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local info = TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(instance, info, properties)
	t:Play()
	return t
end

local function makePart(properties): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in properties do
		(part :: any)[key] = value
	end
	part.Parent = fxFolder
	return part
end

local function playSound(position: Vector3, soundId: string, volume: number, speed: number)
	local holder = makePart({ Size = Vector3.one, Transparency = 1, CFrame = CFrame.new(position) })
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume
	sound.PlaybackSpeed = speed
	sound.RollOffMaxDistance = 120
	sound.Parent = holder
	sound:Play()
	Debris:AddItem(holder, 2)
end

local function burst(position: Vector3, color: Color3, count: number, speed: number, size: number)
	local holder = makePart({ Size = Vector3.one, Transparency = 1, CFrame = CFrame.new(position) })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.8
	emitter.Size = NumberSequence.new(size, 0)
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(0.25, 0.5)
	emitter.Speed = NumberRange.new(speed * 0.6, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 4
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
	Debris:AddItem(holder, 1.5)
end

local function floatingText(position: Vector3, text: string, color: Color3, big: boolean)
	local anchor = makePart({
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
		CFrame = CFrame.new(position + Vector3.new((math.random() - 0.5) * 2, 0, (math.random() - 0.5) * 2)),
	})
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(big and 220 or 160, big and 60 or 44)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 150
	gui.Adornee = anchor
	gui.Parent = anchor

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.Parent = gui

	local scale = Instance.new("UIScale")
	scale.Scale = 0.4
	scale.Parent = label
	tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(gui, 0.9, { StudsOffset = Vector3.new(0, 3, 0) })
	task.delay(0.45, function()
		tween(label, 0.45, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(anchor, 1)
end

local function shakeCamera(intensity: number, duration: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	task.spawn(function()
		local start = os.clock()
		while os.clock() - start < duration do
			local fade = 1 - (os.clock() - start) / duration
			humanoid.CameraOffset = Vector3.new(
				(math.random() - 0.5) * intensity * fade,
				(math.random() - 0.5) * intensity * fade,
				0
			)
			task.wait()
		end
		humanoid.CameraOffset = Vector3.zero
	end)
end

--------------------------------------------------------------------------
-- Tipos de efeito
--------------------------------------------------------------------------
local handlers = {}

function handlers.Hit(data)
	local color: Color3 = data.Color or Color3.new(1, 1, 1)
	local size = data.Crit and 4.5 or 3
	local sphere = makePart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.5,
		Color = data.Crit and Color3.fromRGB(255, 230, 90) or color,
		Transparency = 0.1,
		CFrame = CFrame.new(data.Position),
	})
	tween(sphere, 0.25, { Size = Vector3.one * size, Transparency = 1 })
	Debris:AddItem(sphere, 0.3)
	burst(data.Position, color, data.Crit and 22 or 12, 28, 0.35)
	playSound(data.Position, SLASH_SOUND, 0.35, 1.3 + math.random() * 0.3)
end

function handlers.Damage(data)
	local text = tostring(data.Amount)
	local color = Color3.fromRGB(255, 255, 255)
	if data.Crit then
		text = "CRÍTICO! " .. text
		color = Color3.fromRGB(255, 220, 60)
	elseif data.Color and data.Color ~= Color3.new(1, 1, 1) then
		color = data.Color
	end
	floatingText(data.Position, text, color, data.Crit == true)
	shakeCamera(data.Crit and 0.5 or 0.25, 0.12)
end

function handlers.Text(data)
	floatingText(data.Position + Vector3.new(0, 3, 0), data.Text, data.Color or Color3.new(1, 1, 1), true)
end

function handlers.Block(data)
	burst(data.Position, Color3.fromRGB(140, 200, 255), 10, 18, 0.3)
	playSound(data.Position, SLASH_SOUND, 0.3, 0.7)
end

function handlers.Parry(data)
	local ring = makePart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 2, 2),
		Color = Color3.fromRGB(180, 230, 255),
		Transparency = 0,
		CFrame = CFrame.new(data.Position) * CFrame.Angles(0, 0, math.rad(90)),
	})
	tween(ring, 0.3, { Size = Vector3.new(0.2, 12, 12), Transparency = 1 })
	Debris:AddItem(ring, 0.35)
	burst(data.Position, Color3.fromRGB(200, 240, 255), 25, 35, 0.4)
	playSound(data.Position, LUNGE_SOUND, 0.6, 1.6)
end

function handlers.Ring(data)
	local radius = data.Radius or 10
	local color: Color3 = data.Color or Color3.new(1, 1, 1)
	local flat = CFrame.new(data.Position) * CFrame.Angles(0, 0, math.rad(90))

	local ring = makePart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 2, 2),
		Color = color,
		Transparency = 0.15,
		CFrame = flat,
	})
	tween(ring, 0.4, { Size = Vector3.new(0.3, radius * 2, radius * 2), Transparency = 1 })
	Debris:AddItem(ring, 0.45)

	local wave = makePart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 2,
		Color = color,
		Transparency = 0.5,
		CFrame = CFrame.new(data.Position + Vector3.new(0, 2, 0)),
		Material = Enum.Material.ForceField,
	})
	tween(wave, 0.35, { Size = Vector3.one * radius * 1.6, Transparency = 1 })
	Debris:AddItem(wave, 0.4)

	burst(data.Position + Vector3.new(0, 1.5, 0), color, 40, radius * 3, 0.6)

	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = radius * 1.5
	light.Brightness = 4
	light.Parent = ring
	playSound(data.Position, LUNGE_SOUND, 0.6, 0.8)
end

function handlers.Telegraph(data)
	local radius = data.Radius or 10
	local duration = data.Duration or 1
	local flat = CFrame.new(data.Position + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90))

	local outline = makePart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.15, radius * 2, radius * 2),
		Color = Color3.fromRGB(255, 40, 40),
		Transparency = 0.7,
		CFrame = flat,
	})
	local fill = makePart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 0.5, 0.5),
		Color = Color3.fromRGB(255, 60, 40),
		Transparency = 0.45,
		CFrame = flat,
	})
	tween(fill, duration, { Size = Vector3.new(0.2, radius * 2, radius * 2) }, Enum.EasingStyle.Linear)
	Debris:AddItem(outline, duration)
	Debris:AddItem(fill, duration)
end

function handlers.Lightning(data)
	local from: Vector3, to: Vector3 = data.From, data.To
	local segments = 7
	local points = { from }
	for i = 1, segments - 1 do
		local alpha = i / segments
		local point = from:Lerp(to, alpha)
			+ Vector3.new((math.random() - 0.5) * 3, (math.random() - 0.5) * 3, (math.random() - 0.5) * 3)
		table.insert(points, point)
	end
	table.insert(points, to)

	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local length = (b - a).Magnitude
		local bolt = makePart({
			Size = Vector3.new(0.35, 0.35, length),
			Color = Color3.fromRGB(255, 245, 160),
			CFrame = CFrame.lookAt((a + b) / 2, b),
		})
		tween(bolt, 0.3, { Transparency = 1, Size = Vector3.new(0.05, 0.05, length) })
		Debris:AddItem(bolt, 0.35)
	end
	burst(to, Color3.fromRGB(255, 240, 140), 15, 30, 0.4)
	playSound(to, LUNGE_SOUND, 0.4, 2)
end

function handlers.Dash(data)
	burst(data.Position - Vector3.new(0, 2, 0), Color3.fromRGB(230, 230, 230), 14, 12, 0.8)
end

function handlers.Death(data)
	burst(data.Position, Color3.fromRGB(40, 30, 50), 30, 15, 1.2)
	local soul = makePart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.2,
		Color = Color3.fromRGB(220, 230, 255),
		Transparency = 0.3,
		CFrame = CFrame.new(data.Position),
	})
	tween(soul, 1.5, { CFrame = CFrame.new(data.Position + Vector3.new(0, 12, 0)), Transparency = 1 })
	Debris:AddItem(soul, 1.6)
end

function handlers.LevelUp(data)
	local beam = makePart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(60, 3, 3),
		Color = Color3.fromRGB(255, 215, 80),
		Transparency = 0.2,
		CFrame = CFrame.new(data.Position + Vector3.new(0, 27, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	})
	tween(beam, 1.2, { Size = Vector3.new(60, 8, 8), Transparency = 1 })
	Debris:AddItem(beam, 1.3)
	handlers.Ring({
		Position = data.Position - Vector3.new(0, 2.5, 0),
		Radius = 10,
		Color = Color3.fromRGB(255, 215, 80),
	})
end

--------------------------------------------------------------------------
function EffectsController.Init()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "ClientFX"
	fxFolder.Parent = workspace

	Remotes.Effect.OnClientEvent:Connect(function(data)
		if type(data) ~= "table" then
			return
		end
		local handler = handlers[data.Type]
		if handler then
			local ok, err = pcall(handler, data)
			if not ok then
				warn("[Effects] " .. tostring(err))
			end
		end
	end)
end

EffectsController.FloatingText = floatingText
EffectsController.Burst = burst

return EffectsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3467">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--[[
	UIController
	Toda a interface do jogo é criada por código aqui:
	  - Painel do jogador (nível, XP, moedas)
	  - Barras de vida e estamina + habilidade especial
	  - Nome da zona atual
	  - Feed de abates e notificações
	  - Barra de vida do chefe
	  - Loja (Ferraria) e janela de controles
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SwordsFolder = ReplicatedStorage:WaitForChild("Swords")
local player = Players.LocalPlayer

local UIController = {}

--------------------------------------------------------------------------
-- Tema
--------------------------------------------------------------------------
local THEME = {
	Panel = Color3.fromRGB(22, 24, 34),
	PanelLight = Color3.fromRGB(38, 41, 56),
	Stroke = Color3.fromRGB(90, 80, 60),
	Gold = Color3.fromRGB(255, 205, 85),
	Text = Color3.fromRGB(240, 240, 245),
	SubText = Color3.fromRGB(170, 175, 190),
	Health = Color3.fromRGB(80, 220, 100),
	HealthLow = Color3.fromRGB(235, 60, 60),
	Stamina = Color3.fromRGB(255, 200, 60),
	XP = Color3.fromRGB(120, 140, 255),
	Green = Color3.fromRGB(70, 190, 100),
	Red = Color3.fromRGB(200, 60, 60),
	Gray = Color3.fromRGB(90, 92, 105),
}

local function make(className: string, properties, children: { Instance }?): any
	local instance = Instance.new(className)
	for key, value in properties do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if properties.Parent then
		instance.Parent = properties.Parent
	end
	return instance
end

local function corner(radius: number?): UICorner
	return make("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function stroke(color: Color3?, thickness: number?): UIStroke
	return make("UIStroke", {
		Color = color or THEME.Stroke,
		Thickness = thickness or 1.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function panel(properties, children: { Instance }?)
	properties.BackgroundColor3 = properties.BackgroundColor3 or THEME.Panel
	properties.BackgroundTransparency = properties.BackgroundTransparency or 0.15
	properties.BorderSizePixel = 0
	local frame = make("Frame", properties, children)
	corner(10).Parent = frame
	stroke().Parent = frame
	return frame
end

local function label(properties)
	properties.BackgroundTransparency = 1
	properties.Font = properties.Font or Enum.Font.GothamBold
	properties.TextColor3 = properties.TextColor3 or THEME.Text
	properties.TextScaled = properties.TextScaled ~= false
	return make("TextLabel", properties)
end

local function button(properties)
	properties.AutoButtonColor = true
	properties.BorderSizePixel = 0
	properties.Font = properties.Font or Enum.Font.GothamBlack
	properties.TextColor3 = properties.TextColor3 or THEME.Text
	properties.TextScaled = true
	local btn = make("TextButton", properties)
	corner(8).Parent = btn
	make("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		Parent = btn,
	})
	return btn
end

local function bar(parent: Instance, properties, fillColor: Color3)
	properties.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	properties.BorderSizePixel = 0
	properties.Parent = parent
	local back = make("Frame", properties)
	corner(6).Parent = back
	stroke(Color3.fromRGB(0, 0, 0), 1.5).Parent = back
	local fill = make("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = fillColor,
		BorderSizePixel = 0,
		Parent = back,
	})
	corner(6).Parent = fill
	make("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
		Rotation = 90,
		Parent = fill,
	})
	local text = label({
		Name = "Label",
		Size = UDim2.new(1, -8, 1, -4),
		Position = UDim2.fromOffset(4, 2),
		Text = "",
		ZIndex = 3,
		TextStrokeTransparency = 0.4,
		Parent = back,
	})
	return back, fill, text
end

local function tween(instance: Instance, seconds: number, properties, style: Enum.EasingStyle?)
	local t = TweenService:Create(instance, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad), properties)
	t:Play()
	return t
end

--------------------------------------------------------------------------
-- Estado
--------------------------------------------------------------------------
local screen: ScreenGui
local hud = {} :: any
local shop = {} :: any
local controlsWindow: Frame
local bigQueue = {}
local showingBig = false
local orderCounter = 0

local function nextOrder(): number
	orderCounter += 1
	return orderCounter
end

local function getOwned(): { [string]: boolean }
	local raw = player:GetAttribute("Owned")
	if type(raw) ~= "string" then
		return {}
	end
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	return ok and decoded or {}
end

--------------------------------------------------------------------------
-- Notificações
--------------------------------------------------------------------------
local function colorFrom(value): Color3
	if typeof(value) == "Color3" then
		return value
	elseif type(value) == "table" then
		return Util.Color(value)
	end
	return THEME.Gold
end

local function showNextBig()
	if showingBig or #bigQueue == 0 then
		return
	end
	showingBig = true
	local data = table.remove(bigQueue, 1)
	local holder = hud.BigNotify
	holder.Title.Text = data.Text or ""
	holder.Title.TextColor3 = colorFrom(data.Color)
	holder.Sub.Text = data.Sub or ""
	holder.Visible = true
	holder.Title.TextTransparency = 1
	holder.Sub.TextTransparency = 1
	holder.Scale.Scale = 0.6
	tween(holder.Scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(holder.Title, 0.2, { TextTransparency = 0 })
	tween(holder.Sub, 0.2, { TextTransparency = 0 })
	task.delay(2.6, function()
		tween(holder.Title, 0.4, { TextTransparency = 1 })
		tween(holder.Sub, 0.4, { TextTransparency = 1 })
		task.wait(0.45)
		holder.Visible = false
		showingBig = false
		showNextBig()
	end)
end

function UIController.Notify(data)
	if type(data) ~= "table" then
		return
	end
	if data.Small then
		local toast = panel({
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, 0, 0, 52),
			BackgroundTransparency = 0.2,
			Parent = hud.Toasts,
		})
		label({
			Size = UDim2.new(1, -16, 0, 24),
			Position = UDim2.fromOffset(8, 4),
			Text = data.Text or "",
			TextColor3 = colorFrom(data.Color),
			Font = Enum.Font.GothamBlack,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = toast,
		})
		label({
			Size = UDim2.new(1, -16, 0, 18),
			Position = UDim2.fromOffset(8, 28),
			Text = data.Sub or "",
			TextColor3 = THEME.SubText,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = toast,
		})
		task.delay(4, function()
			for _, child in toast:GetDescendants() do
				if child:IsA("TextLabel") then
					tween(child, 0.4, { TextTransparency = 1 })
				elseif child:IsA("UIStroke") then
					tween(child, 0.4, { Transparency = 1 })
				end
			end
			tween(toast, 0.4, { BackgroundTransparency = 1 })
			task.wait(0.45)
			toast:Destroy()
		end)
		return
	end
	table.insert(bigQueue, data)
	showNextBig()
end

local function addKillFeed(data)
	if type(data) ~= "table" then
		return
	end
	local text
	if data.Killer then
		text = ("%s  derrotou  %s"):format(data.Killer, data.Victim or "?")
	else
		text = ("%s caiu"):format(data.Victim or "?")
	end
	local entry = panel({
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 0.3,
		Parent = hud.KillFeed,
	})
	label({
		Size = UDim2.new(1, -12, 1, -8),
		Position = UDim2.fromOffset(6, 4),
		Text = text,
		TextColor3 = data.KillerIsPlayer and Color3.fromRGB(255, 120, 110) or THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = entry,
	})
	local entries = {}
	for _, child in hud.KillFeed:GetChildren() do
		if child:IsA("Frame") then
			table.insert(entries, child)
		end
	end
	table.sort(entries, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	if #entries > 5 then
		entries[1]:Destroy()
	end
	task.delay(7, function()
		if entry.Parent then
			entry:Destroy()
		end
	end)
end

