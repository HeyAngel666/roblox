  <Item class="ServerScriptService" referent="3206">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="3207">
      <Properties>
        <string name="Name">GameServer</string>
        <string name="Source"><![CDATA[--[[
	LÂMINAS DO REINO - Servidor
	Inicia todos os serviços do jogo na ordem certa.
]]

local ServerScriptService = game:GetService("ServerScriptService")

local Services = ServerScriptService:WaitForChild("Services")

local services = {
	DataService = require(Services.DataService),
	ZoneService = require(Services.ZoneService),
	CombatService = require(Services.CombatService),
	PlayerService = require(Services.PlayerService),
	ShopService = require(Services.ShopService),
	NPCService = require(Services.NPCService),
	WorldService = require(Services.WorldService),
}

local order = {
	"DataService",
	"ZoneService",
	"CombatService",
	"PlayerService",
	"ShopService",
	"NPCService",
	"WorldService",
}

for _, name in order do
	local ok, err = pcall(services[name].Init, services)
	if not ok then
		warn(("[GameServer] Erro ao iniciar %s: %s"):format(name, tostring(err)))
	end
end

print("[Lâminas do Reino] Servidor iniciado!")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="3208">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="3209">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--[[
	CombatService
	Todo o combate acontece aqui, no servidor (seguro contra exploits):
	- Ataques com combo de 3 golpes (o 3º empurra o inimigo)
	- Bloqueio (F) e Parry (bloquear no momento certo atordoa o atacante)
	- Esquiva (Q) com invencibilidade curta
	- Habilidade especial (E) de cada espada
	- Efeitos de elemento: Fogo, Gelo, Sombra, Raio e Abismo
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local ZoneService -- definido em Init (evita dependência circular)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local C = Config.Combat

local CombatService = {}

type PlayerState = {
	Combo: number,
	LastAttack: number,
	Blocking: boolean,
	BlockStart: number,
	Stamina: number,
	LastStaminaUse: number,
	LastStaminaSent: number,
	LastDash: number,
	InvulnUntil: number,
	SpecialReadyAt: number,
}

type Status = {
	StunUntil: number,
	SlowUntil: number,
	SlowMult: number,
	BurnUntil: number,
	BurnNext: number,
	BurnAttacker: Model?,
}

local playerStates: { [Player]: PlayerState } = {}
local statuses: { [Model]: Status } = {}
local lastHits = (setmetatable({}, { __mode = "k" }) :: any) :: { [Humanoid]: { Player: Player?, Model: Model?, Name: string, Time: number } }

CombatService.DamageListeners = {} :: { (target: Model, attackerPlayer: Player?, amount: number) -> () }

local BLOCK_GRIP_ROTATION = CFrame.Angles(0, 0, math.rad(90))

--------------------------------------------------------------------------
-- Utilidades
--------------------------------------------------------------------------
local function now(): number
	return os.clock()
end

local function getState(player: Player): PlayerState
	local state = playerStates[player]
	if not state then
		state = {
			Combo = 0,
			LastAttack = 0,
			Blocking = false,
			BlockStart = 0,
			Stamina = C.StaminaMax,
			LastStaminaUse = 0,
			LastStaminaSent = C.StaminaMax,
			LastDash = 0,
			InvulnUntil = 0,
			SpecialReadyAt = 0,
		}
		playerStates[player] = state
	end
	return state
end

local function getStatus(model: Model): Status
	local status = statuses[model]
	if not status then
		status = {
			StunUntil = 0,
			SlowUntil = 0,
			SlowMult = 1,
			BurnUntil = 0,
			BurnNext = 0,
			BurnAttacker = nil,
		}
		statuses[model] = status
	end
	return status
end

local function elementColor(element: string?): Color3
	local data = Config.Elements[element or "none"] or Config.Elements.none
	return Util.Color(data.Color)
end

local function fireEffect(payload)
	Remotes.Effect:FireAllClients(payload)
end

local function floatingText(position: Vector3, text: string, color: Color3)
	fireEffect({ Type = "Text", Position = position, Text = text, Color = color })
end

function CombatService.GetEquippedSword(character: Model?): (Tool?, any)
	if not character then
		return nil, nil
	end
	local tool = character:FindFirstChildOfClass("Tool")
	if not tool then
		return nil, nil
	end
	local swordId = tool:GetAttribute("SwordId")
	local sword = swordId and Config.SwordById[swordId]
	if not sword then
		return nil, nil
	end
	return tool, sword
end

local function playToolAnim(tool: Tool, animName: string)
	local value = Instance.new("StringValue")
	value.Name = "toolanim"
	value.Value = animName
	value.Parent = tool
	Debris:AddItem(value, 0.5)
end

local function playToolSound(tool: Tool, soundName: string)
	local handle = tool:FindFirstChild("Handle")
	local sound = handle and handle:FindFirstChild(soundName)
	if sound and sound:IsA("Sound") then
		sound.PlaybackSpeed = 0.9 + math.random() * 0.2
		sound:Play()
	end
end

local function flashTrail(tool: Tool, duration: number)
	local handle = tool:FindFirstChild("Handle")
	local trail = handle and handle:FindFirstChild("SwordTrail")
	if trail and trail:IsA("Trail") then
		trail.Enabled = true
		task.delay(duration, function()
			if trail.Parent then
				trail.Enabled = false
			end
		end)
	end
end

local function useStamina(state: PlayerState, amount: number)
	state.Stamina = math.max(0, state.Stamina - amount)
	state.LastStaminaUse = now()
end

--------------------------------------------------------------------------
-- Velocidade / Atordoamento / Lentidão
--------------------------------------------------------------------------
function CombatService.UpdateSpeed(model: Model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local base = model:GetAttribute("BaseSpeed") or C.BaseWalkSpeed
	local jump = model:GetAttribute("BaseJump") or C.BaseJumpHeight
	local status = statuses[model]
	local t = now()

	if status and status.StunUntil > t then
		humanoid.WalkSpeed = 0
		humanoid.JumpHeight = 0
		return
	end

	local multiplier = 1
	if model:GetAttribute("Blocking") then
		multiplier *= C.BlockSpeedMultiplier
	end
	if status and status.SlowUntil > t then
		multiplier *= status.SlowMult
	end
	humanoid.WalkSpeed = base * multiplier
	humanoid.JumpHeight = jump
end

function CombatService.IsStunned(model: Model): boolean
	local status = statuses[model]
	return status ~= nil and status.StunUntil > now()
end

function CombatService.Stun(model: Model, duration: number)
	local status = getStatus(model)
	status.StunUntil = math.max(status.StunUntil, now() + duration)
	model:SetAttribute("Stunned", true)

	local player = Players:GetPlayerFromCharacter(model)
	if player then
		CombatService.SetBlocking(player, false)
	end
	CombatService.UpdateSpeed(model)
end

function CombatService.Slow(model: Model, multiplier: number, duration: number)
	local status = getStatus(model)
	status.SlowUntil = now() + duration
	status.SlowMult = multiplier
	model:SetAttribute("Slowed", true)
	CombatService.UpdateSpeed(model)
end

function CombatService.Burn(model: Model, attacker: Model?)
	local fire = Config.Elements.fire
	local status = getStatus(model)
	local t = now()
	if status.BurnUntil < t then
		status.BurnNext = t + fire.BurnInterval
	end
	status.BurnUntil = t + fire.BurnTicks * fire.BurnInterval
	status.BurnAttacker = attacker
	model:SetAttribute("Burning", true)
end

function CombatService.IsInvulnerable(player: Player): boolean
	return getState(player).InvulnUntil > now()
end

function CombatService.GetLastAttacker(humanoid: Humanoid)
	local hit = lastHits[humanoid]
	if hit and now() - hit.Time <= C.KillCreditTime then
		return hit
	end
	return nil
end

--------------------------------------------------------------------------
-- Regras de quem pode bater em quem
--------------------------------------------------------------------------
local function canDamage(attacker: Model?, target: Model): boolean
	if attacker == target or target:GetAttribute("Invulnerable") then
		return false
	end
	local targetPlayer = Players:GetPlayerFromCharacter(target)
	local attackerPlayer = attacker and Players:GetPlayerFromCharacter(attacker)
	local attackerIsNPC = attacker ~= nil and attacker:GetAttribute("NPC") ~= nil

	if target:GetAttribute("Dummy") then
		return attackerPlayer ~= nil
	end
	if attackerIsNPC and target:GetAttribute("NPC") ~= nil then
		return false -- NPCs não brigam entre si
	end
	if targetPlayer then
		if ZoneService.IsSafe(targetPlayer) then
			return false
		end
		if attackerPlayer and ZoneService.IsSafe(attackerPlayer) then
			return false
		end
	end
	return true
end

--------------------------------------------------------------------------
-- DANO
-- info = { Source = "melee" | "special" | "chain" | "burn" | "slam",
--          Element = string?, Knockback = boolean?, CanBeBlocked = boolean?,
--          NoCrit = boolean? }
--------------------------------------------------------------------------
function CombatService.DealDamage(attacker: Model?, target: Model, amount: number, info): number
	info = info or {}
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	local root = Util.GetRoot(target)
	if not humanoid or humanoid.Health <= 0 or not root then
		return 0
	end
	if not canDamage(attacker, target) then
		return 0
	end

	local attackerPlayer = attacker and Players:GetPlayerFromCharacter(attacker)
	local targetPlayer = Players:GetPlayerFromCharacter(target)
	local attackerRoot = attacker and Util.GetRoot(attacker)
	local element = info.Element or "none"
	local source = info.Source or "melee"
	local canBeBlocked = info.CanBeBlocked ~= false
	local damage = amount
	local crit = false

	-- Esquiva (invencível durante o dash)
	if targetPlayer and CombatService.IsInvulnerable(targetPlayer) then
		floatingText(root.Position, "ESQUIVOU!", Color3.fromRGB(200, 230, 255))
		return 0
	end

	-- Bloqueio / Parry
	if targetPlayer and canBeBlocked and attackerRoot then
		local state = getState(targetPlayer)
		if state.Blocking then
			local toAttacker = attackerRoot.Position - root.Position
			local flat = Vector3.new(toAttacker.X, 0, toAttacker.Z)
			local facing = flat.Magnitude < 0.01 or root.CFrame.LookVector:Dot(flat.Unit) > -0.1
			if facing then
				if source == "melee" and now() - state.BlockStart <= C.ParryWindow and attacker then
					CombatService.Stun(attacker, C.ParryStun)
					floatingText(root.Position, "PARRY!", Color3.fromRGB(120, 200, 255))
					fireEffect({ Type = "Parry", Position = root.Position })
					return 0
				end
				if element ~= "void" then
					damage *= (1 - C.BlockReduction)
					useStamina(state, C.BlockStaminaCost)
					fireEffect({ Type = "Block", Position = root.Position })
					if state.Stamina <= 0 then
						CombatService.Stun(target, C.GuardBreakStun)
						floatingText(root.Position, "GUARDA QUEBRADA!", Color3.fromRGB(255, 160, 60))
					end
				end
			end
		end
	end

	-- Crítico (somente golpes de jogadores)
	if attackerPlayer and not info.NoCrit and (source == "melee" or source == "special") then
		if math.random() < C.CritChance then
			damage *= C.CritMultiplier
			crit = true
		end
	end

	-- Abismo executa alvos com pouca vida
	if element == "void" then
		local void = Config.Elements.void
		if humanoid.Health / humanoid.MaxHealth <= void.ExecuteThreshold then
			damage *= void.ExecuteMultiplier
		end
	end

	damage = math.max(1, math.floor(damage + 0.5))

	-- Registra quem bateu (para dar o crédito do abate)
	if attacker then
		lastHits[humanoid] = {
			Player = attackerPlayer,
			Model = attacker,
			Name = attackerPlayer and attackerPlayer.DisplayName
				or (attacker:GetAttribute("DisplayName") or attacker.Name),
			Time = now(),
		}
	end

	local before = humanoid.Health
	humanoid:TakeDamage(damage)
	local dealt = before - humanoid.Health
	if dealt <= 0 then
		return 0
	end

	for _, listener in CombatService.DamageListeners do
		task.spawn(listener, target, attackerPlayer, dealt)
	end

	-- Efeitos visuais
	local color = elementColor(element)
	if source ~= "burn" then
		fireEffect({ Type = "Hit", Position = root.Position, Color = color, Crit = crit })
	end
	if attackerPlayer then
		Remotes.Effect:FireClient(attackerPlayer, {
			Type = "Damage",
			Position = root.Position + Vector3.new(0, 2, 0),
			Amount = math.floor(dealt + 0.5),
			Crit = crit,
			Color = color,
		})
	end

	-- Efeitos de elemento
	if element == "fire" then
		CombatService.Burn(target, attacker)
	elseif element == "ice" then
		local ice = Config.Elements.ice
		CombatService.Slow(target, ice.SlowMultiplier, ice.SlowDuration)
	elseif element == "shadow" and attacker then
		local attackerHumanoid = attacker:FindFirstChildOfClass("Humanoid")
		if attackerHumanoid and attackerHumanoid.Health > 0 then
			attackerHumanoid.Health = math.min(
				attackerHumanoid.MaxHealth,
				attackerHumanoid.Health + dealt * Config.Elements.shadow.Lifesteal
			)
		end
	elseif element == "lightning" and source ~= "chain" then
		CombatService.ChainLightning(attacker, target, dealt)
	end

	-- Empurrão
	if info.Knockback and attackerRoot and humanoid.Health > 0 then
		local direction = root.Position - attackerRoot.Position
		direction = Vector3.new(direction.X, 0, direction.Z)
		if direction.Magnitude < 0.01 then
			direction = attackerRoot.CFrame.LookVector
		end
		local velocity = direction.Unit * C.KnockbackForce + Vector3.new(0, 22, 0)
		if targetPlayer then
			Remotes.Knockback:FireClient(targetPlayer, velocity)
		elseif not root.Anchored then
			root.AssemblyLinearVelocity = velocity
		end
	end

	return dealt
end

function CombatService.ChainLightning(attacker: Model?, origin: Model, baseDamage: number)
	local lightning = Config.Elements.lightning
	local originRoot = Util.GetRoot(origin)
	if not originRoot then
		return
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { origin, attacker :: any }

	local candidates = {}
	local seen = {}
	for _, part in workspace:GetPartBoundsInRadius(originRoot.Position, lightning.ChainRadius, params) do
		local model = Util.GetCharacterFromPart(part)
		if model and not seen[model] and Util.IsAlive(model) and canDamage(attacker, model) then
			seen[model] = true
			local root = Util.GetRoot(model) :: BasePart
			table.insert(candidates, { Model = model, Distance = (root.Position - originRoot.Position).Magnitude })
		end
	end
	table.sort(candidates, function(a, b)
		return a.Distance < b.Distance
	end)
	for i = 1, math.min(lightning.ChainTargets, #candidates) do
		local model = candidates[i].Model
		local root = Util.GetRoot(model)
		if root then
			fireEffect({ Type = "Lightning", From = originRoot.Position, To = root.Position })
			CombatService.DealDamage(attacker, model, baseDamage * lightning.ChainMultiplier, {
				Source = "chain",
				Element = "lightning",
				CanBeBlocked = false,
				NoCrit = true,
			})
		end
	end
end

--------------------------------------------------------------------------
-- Busca de alvos
--------------------------------------------------------------------------
local function collectTargets(parts: { BasePart }): { Model }
	local found = {}
	local list = {}
	for _, part in parts do
		local model = Util.GetCharacterFromPart(part)
		if model and not found[model] and Util.IsAlive(model) then
			found[model] = true
			table.insert(list, model)
		end
	end
	return list
end

local function queryBox(cframe: CFrame, size: Vector3, exclude: { Instance }): { Model }
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclude
	return collectTargets(workspace:GetPartBoundsInBox(cframe, size, params))
end

local function queryRadius(position: Vector3, radius: number, exclude: { Instance }): { Model }
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclude
	return collectTargets(workspace:GetPartBoundsInRadius(position, radius, params))
end

CombatService.QueryRadius = queryRadius

--------------------------------------------------------------------------
-- Ações do jogador (chamadas pelos RemoteEvents)
--------------------------------------------------------------------------
local function getAliveCharacter(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and Util.GetRoot(character)
	if not character or not humanoid or humanoid.Health <= 0 or not root then
		return nil, nil, nil
	end
	return character, humanoid, root
end

function CombatService.Attack(player: Player)
	local character, humanoid, root = getAliveCharacter(player)
	if not character or not humanoid or not root then
		return
	end
	local tool, sword = CombatService.GetEquippedSword(character)
	if not tool or not sword then
		return
	end
	local state = getState(player)
	local t = now()
	if CombatService.IsStunned(character) or state.Blocking then
		return
	end
	if t - state.LastAttack < sword.Cooldown then
		return
	end

	if t - state.LastAttack > C.ComboWindow then
		state.Combo = 0
	end
	state.Combo = state.Combo % 3 + 1
	local combo = state.Combo
	local finisher = combo == 3
	state.LastAttack = finisher and (t + C.FinisherExtraDelay) or t
	player:SetAttribute("Combo", combo)

	playToolAnim(tool, finisher and "Lunge" or "Slash")
	playToolSound(tool, finisher and "Lunge" or "Slash")
	flashTrail(tool, 0.35)

	task.delay(C.HitDelay, function()
		if not character.Parent or humanoid.Health <= 0 or tool.Parent ~= character then
			return
		end
		if CombatService.IsStunned(character) then
			return
		end
		local range = sword.Range + (finisher and 1.5 or 0)
		local boxCFrame = root.CFrame * CFrame.new(0, 0, -range / 2)
		local size = Vector3.new(C.HitboxWidth, C.HitboxHeight, range)
		local damage = sword.Damage * C.ComboMultipliers[combo]
		for _, target in queryBox(boxCFrame, size, { character }) do
			CombatService.DealDamage(character, target, damage, {
				Source = "melee",
				Element = sword.Element,
				Knockback = finisher,
			})
		end
	end)
end

function CombatService.SetBlocking(player: Player, blocking: boolean)
	local state = getState(player)
	local character = player.Character
	if not character then
		state.Blocking = false
		return
	end

	if blocking then
		if state.Blocking then
			return
		end
		local tool, sword = CombatService.GetEquippedSword(character)
		if not tool or not sword or CombatService.IsStunned(character) or state.Stamina < 5 then
			return
		end
		if not Util.IsAlive(character) then
			return
		end
		state.Blocking = true
		state.BlockStart = now()
		character:SetAttribute("Blocking", true)

		if tool:GetAttribute("BaseGrip") == nil then
			tool:SetAttribute("BaseGrip", tool.Grip)
		end
		tool.Grip = (tool:GetAttribute("BaseGrip") :: CFrame) * BLOCK_GRIP_ROTATION

		local highlight = Instance.new("Highlight")
		highlight.Name = "BlockHighlight"
		highlight.FillColor = Color3.fromRGB(120, 190, 255)
		highlight.OutlineColor = Color3.fromRGB(200, 230, 255)
		highlight.FillTransparency = 0.8
		highlight.OutlineTransparency = 0.2
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.Parent = character
	else
		if not state.Blocking then
			return
		end
		state.Blocking = false
		character:SetAttribute("Blocking", false)
		local containers: { Instance } = { character }
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack then
			table.insert(containers, backpack)
		end
		for _, container in containers do
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute("BaseGrip") then
					child.Grip = child:GetAttribute("BaseGrip") :: CFrame
				end
			end
		end
		local highlight = character:FindFirstChild("BlockHighlight")
		if highlight then
			highlight:Destroy()
		end
	end
	CombatService.UpdateSpeed(character)
end

function CombatService.Dash(player: Player)
	local character = getAliveCharacter(player)
	if not character then
		return
	end
	local state = getState(player)
	local t = now()
	if CombatService.IsStunned(character) or state.Blocking then
		return
	end
	if t - state.LastDash < C.DashCooldown or state.Stamina < C.DashCost then
		return
	end
	state.LastDash = t
	state.InvulnUntil = t + C.DashInvulnerability
	useStamina(state, C.DashCost)
	local root = Util.GetRoot(character)
	if root then
		fireEffect({ Type = "Dash", Position = root.Position })
	end
end

function CombatService.Special(player: Player)
	local character, humanoid, root = getAliveCharacter(player)
	if not character or not humanoid or not root then
		return
	end
	local tool, sword = CombatService.GetEquippedSword(character)
	if not tool or not sword then
		return
	end
	local state = getState(player)
	local t = now()
	if CombatService.IsStunned(character) or state.Blocking or t < state.SpecialReadyAt then
		return
	end
	state.SpecialReadyAt = t + sword.SpecialCooldown
	player:SetAttribute("SpecialReadyAt", workspace:GetServerTimeNow() + sword.SpecialCooldown)
	player:SetAttribute("SpecialCooldown", sword.SpecialCooldown)

	playToolAnim(tool, "Lunge")
	playToolSound(tool, "Lunge")
	flashTrail(tool, 0.5)

	local color = elementColor(sword.Element)
	fireEffect({
		Type = "Ring",
		Position = root.Position - Vector3.new(0, 2.5, 0),
		Radius = sword.SpecialRadius,
		Color = color,
		Element = sword.Element,
	})

	task.delay(0.15, function()
		if not character.Parent or humanoid.Health <= 0 then
			return
		end
		for _, target in queryRadius(root.Position, sword.SpecialRadius, { character }) do
			if sword.Element == "lightning" then
				local targetRoot = Util.GetRoot(target)
				if targetRoot then
					fireEffect({
						Type = "Lightning",
						From = targetRoot.Position + Vector3.new(0, 40, 0),
						To = targetRoot.Position,
					})
				end
			end
			CombatService.DealDamage(character, target, sword.SpecialDamage, {
				Source = "special",
				Element = sword.Element,
				Knockback = true,
			})
		end
	end)
end

--------------------------------------------------------------------------
-- Ciclo de atualização (estamina, queimadura, fim de efeitos)
--------------------------------------------------------------------------
local function clearVisual(model: Model, name: string)
	local root = Util.GetRoot(model)
	local visual = root and root:FindFirstChild(name)
	if visual then
		visual:Destroy()
	end
end

local function ensureVisual(model: Model, name: string, create: () -> Instance)
	local root = Util.GetRoot(model)
	if root and not root:FindFirstChild(name) then
		local visual = create()
		visual.Name = name
		visual.Parent = root
	end
end

local statusAccumulator = 0

local function updateStatuses()
	local t = now()
	for model, status in statuses do
		if not model.Parent then
			statuses[model] = nil
			continue
		end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local alive = humanoid ~= nil and humanoid.Health > 0

		-- Atordoamento
		if model:GetAttribute("Stunned") and status.StunUntil <= t then
			model:SetAttribute("Stunned", false)
			CombatService.UpdateSpeed(model)
		end

		-- Lentidão
		if model:GetAttribute("Slowed") then
			if status.SlowUntil <= t or not alive then
				model:SetAttribute("Slowed", false)
				clearVisual(model, "FrostFX")
				CombatService.UpdateSpeed(model)
			else
				ensureVisual(model, "FrostFX", function()
					local emitter = Instance.new("ParticleEmitter")
					emitter.Color = ColorSequence.new(Color3.fromRGB(170, 230, 255))
					emitter.LightEmission = 0.6
					emitter.Size = NumberSequence.new(0.35, 0)
					emitter.Lifetime = NumberRange.new(0.5, 0.9)
					emitter.Rate = 25
					emitter.Speed = NumberRange.new(1, 3)
					emitter.SpreadAngle = Vector2.new(180, 180)
					return emitter
				end)
			end
		end

		-- Queimadura
		if model:GetAttribute("Burning") then
			if status.BurnUntil <= t or not alive then
				model:SetAttribute("Burning", false)
				clearVisual(model, "BurnFX")
			else
				ensureVisual(model, "BurnFX", function()
					local fire = Instance.new("Fire")
					fire.Size = 4
					fire.Heat = 6
					fire.Color = Color3.fromRGB(255, 120, 30)
					fire.SecondaryColor = Color3.fromRGB(255, 220, 80)
					return fire
				end)
				if t >= status.BurnNext then
					status.BurnNext = t + Config.Elements.fire.BurnInterval
					local attacker = status.BurnAttacker
					if attacker and not attacker.Parent then
						attacker = nil
					end
					CombatService.DealDamage(attacker, model, Config.Elements.fire.BurnDamage, {
						Source = "burn",
						CanBeBlocked = false,
						NoCrit = true,
					})
				end
			end
		end
	end
end

local function updateStamina(dt: number)
	local t = now()
	for player, state in playerStates do
		if not player.Parent then
			playerStates[player] = nil
			continue
		end
		if not state.Blocking and t - state.LastStaminaUse >= C.StaminaRegenDelay and state.Stamina < C.StaminaMax then
			state.Stamina = math.min(C.StaminaMax, state.Stamina + C.StaminaRegen * dt)
		end
		-- Se a espada saiu da mão, para de bloquear
		if state.Blocking then
			local tool = CombatService.GetEquippedSword(player.Character)
			if not tool then
				CombatService.SetBlocking(player, false)
			end
		end
		local rounded = math.floor(state.Stamina + 0.5)
		if rounded ~= state.LastStaminaSent then
			state.LastStaminaSent = rounded
			player:SetAttribute("Stamina", rounded)
		end
	end
end

function CombatService.ResetPlayer(player: Player)
	local state = getState(player)
	state.Combo = 0
	state.Blocking = false
	state.Stamina = C.StaminaMax
	state.InvulnUntil = 0
	player:SetAttribute("Stamina", C.StaminaMax)
	player:SetAttribute("StaminaMax", C.StaminaMax)
	player:SetAttribute("Combo", 0)
end

--------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------
function CombatService.Init(services)
	ZoneService = services.ZoneService

	Remotes.Attack.OnServerEvent:Connect(function(player)
		CombatService.Attack(player)
	end)
	Remotes.Block.OnServerEvent:Connect(function(player, blocking)
		if type(blocking) ~= "boolean" then
			return
		end
		CombatService.SetBlocking(player, blocking)
	end)
	Remotes.Dash.OnServerEvent:Connect(function(player)
		CombatService.Dash(player)
	end)
	Remotes.Special.OnServerEvent:Connect(function(player)
		CombatService.Special(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		playerStates[player] = nil
	end)

	RunService.Heartbeat:Connect(function(dt)
		updateStamina(dt)
		statusAccumulator += dt
		if statusAccumulator >= 0.1 then
			statusAccumulator = 0
			updateStatuses()
		end
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3210">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService
	Carrega/salva os dados do jogador (moedas, XP, nível, espadas...)
	Se o DataStore não estiver disponível (ex.: Studio sem "Enable Studio
	Access to API Services"), o jogo funciona normalmente, só não salva.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local STORE_NAME = "LaminasDoReino_v1"
local AUTOSAVE_INTERVAL = 120

local store: DataStore? = nil
local profiles: { [Player]: any } = {}
local canSave: { [Player]: boolean } = {}
local warnedNoSave = false

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local function defaultData()
	return {
		Coins = Config.StartingCoins,
		XP = 0,
		Level = 1,
		Kills = 0,
		Deaths = 0,
		NPCKills = 0,
		BossKills = 0,
		Owned = { [Config.DefaultSword] = true },
		Equipped = Config.DefaultSword,
	}
end

local function reconcile(data)
	local default = defaultData()
	if type(data) ~= "table" then
		return default
	end
	for key, value in pairs(default) do
		if data[key] == nil then
			data[key] = value
		end
	end
	if type(data.Owned) ~= "table" then
		data.Owned = default.Owned
	end
	data.Owned[Config.DefaultSword] = true
	if not Config.SwordById[data.Equipped] or not data.Owned[data.Equipped] then
		data.Equipped = Config.DefaultSword
	end
	return data
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore indisponível: " .. tostring(result))
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for _, player in Players:GetPlayers() do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		local threads = 0
		for _, player in Players:GetPlayers() do
			threads += 1
			task.spawn(function()
				DataService.Save(player)
				threads -= 1
			end)
		end
		local start = os.clock()
		while threads > 0 and os.clock() - start < 20 do
			task.wait(0.1)
		end
	end)
end

function DataService.Load(player: Player)
	local data = nil
	local loaded = false

	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(keyFor(player))
			end)
			if ok then
				data = result
				loaded = true
				break
			end
			warn(("[DataService] Falha ao carregar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(result)))
			if RunService:IsStudio() then
				break -- no Studio não adianta tentar de novo
			end
			task.wait(1)
		end
	end

	if not loaded and not warnedNoSave then
		warnedNoSave = true
		warn(
			"[DataService] O progresso NÃO será salvo nesta sessão. "
				.. "No Studio ative: Game Settings > Security > Enable Studio Access to API Services."
		)
	end

	if not player.Parent then
		return nil
	end

	profiles[player] = reconcile(data)
	canSave[player] = loaded

	DataService.CreateLeaderstats(player)
	DataService.Sync(player)
	return profiles[player]
end

function DataService.Save(player: Player)
	local data = profiles[player]
	if not data or not canSave[player] or not store then
		return
	end
	local ok, err = pcall(function()
		(store :: DataStore):SetAsync(keyFor(player), data)
	end)
	if not ok then
		warn("[DataService] Falha ao salvar " .. player.Name .. ": " .. tostring(err))
	end
end

function DataService.Release(player: Player)
	DataService.Save(player)
	profiles[player] = nil
	canSave[player] = nil
end

function DataService.Get(player: Player)
	return profiles[player]
end

function DataService.CreateLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local level = Instance.new("IntValue")
	level.Name = "Nível"
	level.Parent = leaderstats

	local kills = Instance.new("IntValue")
	kills.Name = "Abates"
	kills.Parent = leaderstats

	local coins = Instance.new("IntValue")
	coins.Name = "Moedas"
	coins.Parent = leaderstats

	leaderstats.Parent = player
end

-- Copia os dados para atributos/leaderstats (o cliente lê daqui)
function DataService.Sync(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	player:SetAttribute("Coins", data.Coins)
	player:SetAttribute("XP", data.XP)
	player:SetAttribute("Level", data.Level)
	player:SetAttribute("XPNeeded", Config.XPForLevel(data.Level))
	player:SetAttribute("Kills", data.Kills)
	player:SetAttribute("Deaths", data.Deaths)
	player:SetAttribute("Equipped", data.Equipped)
	player:SetAttribute("Owned", HttpService:JSONEncode(data.Owned))

	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local values = {
			["Nível"] = data.Level,
			Abates = data.Kills,
			Moedas = data.Coins,
		}
		for name, value in pairs(values) do
			local stat = leaderstats:FindFirstChild(name)
			if stat and stat:IsA("IntValue") then
				stat.Value = value
			end
		end
	end
end

function DataService.AddCoins(player: Player, amount: number)
	local data = profiles[player]
	if not data then
		return
	end
	data.Coins = math.max(0, data.Coins + math.floor(amount))
	DataService.Sync(player)
end

function DataService.SpendCoins(player: Player, amount: number): boolean
	local data = profiles[player]
	if not data or data.Coins < amount then
		return false
	end
	data.Coins -= amount
	DataService.Sync(player)
	return true
end

function DataService.AddXP(player: Player, amount: number)
	local data = profiles[player]
	if not data then
		return
	end
	data.XP += math.floor(amount)
	local leveledUp = false
	while data.Level < Config.MaxLevel and data.XP >= Config.XPForLevel(data.Level) do
		data.XP -= Config.XPForLevel(data.Level)
		data.Level += 1
		leveledUp = true
	end
	if data.Level >= Config.MaxLevel then
		data.XP = math.min(data.XP, Config.XPForLevel(data.Level))
	end
	DataService.Sync(player)

	if leveledUp then
		Remotes.Notify:FireClient(player, {
			Text = "NÍVEL " .. data.Level .. "!",
			Sub = "Vida máxima aumentada",
			Color = { 255, 215, 80 },
		})
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if humanoid and humanoid.Health > 0 then
			humanoid.MaxHealth = Config.MaxHealthForLevel(data.Level)
			humanoid.Health = humanoid.MaxHealth
		end
		if root then
			Remotes.Effect:FireAllClients({ Type = "LevelUp", Position = (root :: BasePart).Position })
		end
	end
end

function DataService.Increment(player: Player, key: string, amount: number)
	local data = profiles[player]
	if not data or type(data[key]) ~= "number" then
		return
	end
	data[key] += amount
	DataService.Sync(player)
end

function DataService.Owns(player: Player, swordId: string): boolean
	local data = profiles[player]
	return data ~= nil and data.Owned[swordId] == true
end

function DataService.AddOwned(player: Player, swordId: string)
	local data = profiles[player]
	if not data then
		return
	end
	data.Owned[swordId] = true
	DataService.Sync(player)
end

function DataService.SetEquipped(player: Player, swordId: string)
	local data = profiles[player]
	if not data then
		return
	end
	data.Equipped = swordId
	DataService.Sync(player)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3211">
        <Properties>
          <string name="Name">NPCService</string>
          <string name="Source"><![CDATA[--[[
	NPCService
	Inimigos controlados pelo servidor:
	- Goblins, Esqueletos e Orcs na Floresta Sombria
	- O chefe "Rei Caído" nas Ruínas (golpe no chão + fase de fúria)
	- Bonecos de treino na Vila (regeneram a vida)
	Os modelos ficam em ServerStorage.NPCs e os pontos de nascimento em
	Workspace.NPCSpawns (peças com o atributo "NPC").
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local CombatService
local DataService
local ZoneService

local NPCService = {}

-- Animações padrão R6 da própria Roblox
local ANIMATIONS = {
	Idle = { Id = 180435571, Priority = Enum.AnimationPriority.Idle, Looped = true },
	Walk = { Id = 180426354, Priority = Enum.AnimationPriority.Movement, Looped = true },
	ToolNone = { Id = 182393478, Priority = Enum.AnimationPriority.Action, Looped = true },
	Slash = { Id = 129967390, Priority = Enum.AnimationPriority.Action2, Looped = false },
	Lunge = { Id = 129967478, Priority = Enum.AnimationPriority.Action2, Looped = false },
}

local THINK_INTERVAL = 0.2

type NPC = {
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Kind: string,
	Config: any,
	Element: string,
	SpawnPart: BasePart?,
	Home: Vector3,
	Target: Model?,
	LastAttack: number,
	LastSlam: number,
	NextWander: number,
	Returning: boolean,
	Slamming: boolean,
	Enraged: boolean,
	Tracks: { [string]: AnimationTrack },
	Damage: { [Player]: number },
	StuckTime: number,
	LastBossUpdate: number,
}

local npcs: { [Model]: NPC } = {}
local npcFolder: Folder
local activeBoss: NPC? = nil

--------------------------------------------------------------------------
-- Visual
--------------------------------------------------------------------------
function NPCService.CreateBillboard(model: Model, title: string, isBoss: boolean)
	local head = model:FindFirstChild("Head")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not head or not humanoid then
		return
	end
	local scale = model:GetAttribute("Scale") or 1

	local gui = Instance.new("BillboardGui")
	gui.Name = "NPCBar"
	gui.Size = UDim2.fromOffset(isBoss and 240 or 170, 44)
	gui.StudsOffset = Vector3.new(0, 1.6 * scale + 1, 0)
	gui.MaxDistance = isBoss and 200 or 90
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 22)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = title
	label.TextColor3 = isBoss and Color3.fromRGB(255, 80, 90) or Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui

	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Position = UDim2.new(0, 0, 0, 26)
	back.Size = UDim2.new(1, 0, 0, 10)
	back.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
	back.BorderSizePixel = 0
	back.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = back
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Parent = back

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = isBoss and Color3.fromRGB(220, 40, 60) or Color3.fromRGB(90, 220, 90)
	fill.BorderSizePixel = 0
	fill.Parent = back
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	gui.Parent = head

	local function update()
		local ratio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
		fill.Size = UDim2.fromScale(ratio, 1)
		if not isBoss then
			fill.BackgroundColor3 = Color3.fromRGB(230, 70, 60):Lerp(Color3.fromRGB(90, 220, 90), ratio)
		end
	end
	humanoid.HealthChanged:Connect(update)
	update()
end

local function loadTracks(humanoid: Humanoid): { [string]: AnimationTrack }
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local tracks = {}
	for name, data in ANIMATIONS do
		local animation = Instance.new("Animation")
		animation.AnimationId = "rbxassetid://" .. data.Id
		local ok, track = pcall(function()
			return (animator :: Animator):LoadAnimation(animation)
		end)
		if ok and track then
			track.Priority = data.Priority
			track.Looped = data.Looped
			tracks[name] = track
		end
	end
	return tracks
end

local function playWeaponSound(model: Model, soundName: string)
	local weapon = model:FindFirstChild("Weapon")
	local handle = weapon and weapon:FindFirstChild("Handle")
	local sound = handle and handle:FindFirstChild(soundName)
	if sound and sound:IsA("Sound") then
		sound.PlaybackSpeed = 0.85 + math.random() * 0.2
		sound:Play()
	end
	local trail = handle and handle:FindFirstChild("SwordTrail")
	if trail and trail:IsA("Trail") then
		trail.Enabled = true
		task.delay(0.35, function()
			if trail.Parent then
				trail.Enabled = false
			end
		end)
	end
end

--------------------------------------------------------------------------
-- Recompensas
--------------------------------------------------------------------------
local function reward(player: Player, cfg, xpMultiplier: number?)
	local multiplier = xpMultiplier or 1
	local coins = math.floor(cfg.Coins * multiplier)
	local xp = math.floor(cfg.XP * multiplier)
	DataService.AddCoins(player, coins)
	DataService.AddXP(player, xp)
	DataService.Increment(player, "NPCKills", 1)
	Remotes.Notify:FireClient(player, {
		Small = true,
		Text = ("+%d moedas   +%d XP"):format(coins, xp),
		Sub = cfg.DisplayName .. " derrotado",
		Color = { 255, 215, 80 },
	})
end

local function sendBossBar(npc: NPC?, target: Player?)
	local payload
	if npc and npc.Humanoid.Health > 0 then
		payload = {
			Active = true,
			Name = npc.Config.DisplayName,
			Health = npc.Humanoid.Health,
			MaxHealth = npc.Humanoid.MaxHealth,
			Enraged = npc.Enraged,
		}
	else
		payload = { Active = false }
	end
	if target then
		Remotes.BossBar:FireClient(target, payload)
	else
		Remotes.BossBar:FireAllClients(payload)
	end
end

local spawnNPC -- declarado abaixo

local function onNPCDied(npc: NPC)
	if npcs[npc.Model] == nil then
		return
	end
	npcs[npc.Model] = nil
	local cfg = npc.Config
	for _, track in npc.Tracks do
		track:Stop()
	end

	Remotes.Effect:FireAllClients({ Type = "Death", Position = npc.Root.Position })

	if cfg.IsBoss then
		activeBoss = nil
		sendBossBar(nil)
		local winners = {}
		for player, damage in npc.Damage do
			if player.Parent and damage >= npc.Humanoid.MaxHealth * cfg.MinContribution then
				table.insert(winners, player)
			end
		end
		local names = {}
		for _, player in winners do
			table.insert(names, player.DisplayName)
			reward(player, cfg)
			DataService.Increment(player, "BossKills", 1)
			local dropId = cfg.DropSword
			if dropId and not DataService.Owns(player, dropId) and math.random() < cfg.DropChance then
				DataService.AddOwned(player, dropId)
				local sword = Config.SwordById[dropId]
				Remotes.Notify:FireClient(player, {
					Text = "ITEM LENDÁRIO!",
					Sub = "Você obteve: " .. sword.Name .. " (equipe na loja)",
					Color = { 255, 60, 80 },
				})
				Remotes.Notify:FireAllClients({
					Small = true,
					Text = player.DisplayName .. " obteve " .. sword.Name .. "!",
					Color = { 255, 80, 90 },
				})
			end
		end
		Remotes.Notify:FireAllClients({
			Text = "O REI CAÍDO FOI DERROTADO!",
			Sub = #names > 0 and ("Heróis: " .. table.concat(names, ", ")) or "",
			Color = { 255, 215, 80 },
		})
	else
		local hit = CombatService.GetLastAttacker(npc.Humanoid)
		if hit and hit.Player and hit.Player.Parent then
			reward(hit.Player, cfg, npc.Model:GetAttribute("Minion") and 0.5 or 1)
		end
	end

	task.delay(3, function()
		npc.Model:Destroy()
	end)

	local spawnPart = npc.SpawnPart
	if spawnPart then
		task.delay(cfg.RespawnTime, function()
			spawnNPC(npc.Kind, spawnPart, nil)
		end)
	end
end

local function enrage(npc: NPC)
	npc.Enraged = true
	local cfg = npc.Config
	npc.Model:SetAttribute("BaseSpeed", cfg.WalkSpeed + 4)
	CombatService.UpdateSpeed(npc.Model)

	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.fromRGB(255, 30, 40)
	highlight.FillTransparency = 0.75
	highlight.OutlineColor = Color3.fromRGB(255, 80, 80)
	highlight.Parent = npc.Model

	local torso = npc.Model:FindFirstChild("Torso")
	if torso then
		local fire = Instance.new("Fire")
		fire.Color = Color3.fromRGB(200, 20, 40)
		fire.SecondaryColor = Color3.fromRGB(40, 0, 0)
		fire.Size = 10
		fire.Parent = torso
	end

	Remotes.Notify:FireAllClients({
		Text = "O REI CAÍDO ESTÁ FURIOSO!",
		Sub = "Ele invocou seus guardas",
		Color = { 255, 60, 70 },
	})
	if cfg.MinionKind then
		for i = 1, cfg.MinionCount do
			local angle = (i / cfg.MinionCount) * math.pi * 2
			local offset = Vector3.new(math.cos(angle) * 8, 0, math.sin(angle) * 8)
			local groundY = npc.Root.Position.Y - ((npc.Model:GetAttribute("SpawnHeight") :: number?) or 3)
			local position = Vector3.new(npc.Root.Position.X, groundY, npc.Root.Position.Z) + offset
			spawnNPC(cfg.MinionKind, nil, CFrame.new(position), npc.Home)
		end
	end
	sendBossBar(npc)
end

--------------------------------------------------------------------------
-- Nascimento
--------------------------------------------------------------------------
spawnNPC = function(kind: string, spawnPart: BasePart?, groundCFrame: CFrame?, home: Vector3?)
	local cfg = Config.NPCs[kind]
	local template = ServerStorage.NPCs:FindFirstChild(kind)
	if not cfg or not template then
		warn("[NPCService] NPC desconhecido: " .. tostring(kind))
		return
	end
	local model = template:Clone() :: Model
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local spawnHeight = model:GetAttribute("SpawnHeight") or 3

	local baseCFrame = groundCFrame or (spawnPart and spawnPart.CFrame) or CFrame.new()
	local groundPosition = baseCFrame.Position
	if spawnPart then
		groundPosition = Vector3.new(groundPosition.X, spawnPart.Position.Y - spawnPart.Size.Y / 2, groundPosition.Z)
	end
	local yaw = math.random() * math.pi * 2
	model:PivotTo(CFrame.new(groundPosition + Vector3.new(0, spawnHeight + 0.2, 0)) * CFrame.Angles(0, yaw, 0))

	humanoid.MaxHealth = cfg.MaxHealth
	humanoid.Health = cfg.MaxHealth
	humanoid.WalkSpeed = cfg.WalkSpeed
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	model:SetAttribute("NPC", kind)
	model:SetAttribute("DisplayName", cfg.DisplayName)
	model:SetAttribute("BaseSpeed", cfg.WalkSpeed)
	if not spawnPart then
		model:SetAttribute("Minion", true)
	end
	model.Parent = npcFolder
	CollectionService:AddTag(model, "NPC")

	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	NPCService.CreateBillboard(model, ("%s  Nv.%d"):format(cfg.DisplayName, cfg.Level), cfg.IsBoss == true)

	local sword = Config.SwordById[cfg.Sword or ""]
	local npc: NPC = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Kind = kind,
		Config = cfg,
		Element = sword and sword.Element or "none",
		SpawnPart = spawnPart,
		Home = home or groundPosition,
		Target = nil,
		LastAttack = 0,
		LastSlam = os.clock(),
		NextWander = os.clock() + math.random() * 4,
		Returning = false,
		Slamming = false,
		Enraged = false,
		Tracks = loadTracks(humanoid),
		Damage = {},
		StuckTime = 0,
		LastBossUpdate = 0,
	}
	npcs[model] = npc

	if npc.Tracks.Idle then
		npc.Tracks.Idle:Play()
	end
	if npc.Tracks.ToolNone then
		npc.Tracks.ToolNone:Play()
	end

	humanoid.Running:Connect(function(speed)
		local walk = npc.Tracks.Walk
		if not walk then
			return
		end
		if speed > 0.5 then
			if not walk.IsPlaying then
				walk:Play(0.2)
			end
			walk:AdjustSpeed(math.max(speed / 14, 0.5))
		elseif walk.IsPlaying then
			walk:Stop(0.2)
		end
	end)

	humanoid.HealthChanged:Connect(function(health)
		if cfg.IsBoss and health > 0 then
			if not npc.Enraged and health / humanoid.MaxHealth <= cfg.EnrageAt then
				enrage(npc)
			end
			if os.clock() - npc.LastBossUpdate > 0.2 then
				npc.LastBossUpdate = os.clock()
				sendBossBar(npc)
			end
		end
	end)

	humanoid.Died:Connect(function()
		onNPCDied(npc)
	end)

	if cfg.IsBoss then
		activeBoss = npc
		sendBossBar(npc)
		Remotes.Notify:FireAllClients({
			Text = "O REI CAÍDO DESPERTOU!",
			Sub = "Vá até as Ruínas (oeste) para enfrentá-lo",
			Color = { 255, 60, 70 },
		})
	end

	return npc
end

--------------------------------------------------------------------------
-- Inteligência artificial
--------------------------------------------------------------------------
local function isValidTarget(npc: NPC, character: Model?): boolean
	if not character or not Util.IsAlive(character) then
		return false
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player or ZoneService.IsSafe(player) then
		return false
	end
	local root = Util.GetRoot(character) :: BasePart
	local fromHome = (root.Position - npc.Home).Magnitude
	return fromHome <= npc.Config.LeashRange
end

local function findTarget(npc: NPC): Model?
	local best, bestDistance = nil, npc.Config.AggroRange
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character and isValidTarget(npc, character) then
			local root = Util.GetRoot(character) :: BasePart
			local distance = (root.Position - npc.Root.Position).Magnitude
			if distance < bestDistance then
				best, bestDistance = character, distance
			end
		end
	end
	return best
end

local function attack(npc: NPC, target: Model)
	npc.LastAttack = os.clock()
	local cfg = npc.Config
	local track = (cfg.IsBoss and math.random() < 0.4) and npc.Tracks.Lunge or npc.Tracks.Slash
	if track then
		track:Play(0.05)
	end
	playWeaponSound(npc.Model, "Slash")

	task.delay(0.35, function()
		if npc.Humanoid.Health <= 0 or CombatService.IsStunned(npc.Model) then
			return
		end
		local targetRoot = Util.GetRoot(target)
		if not targetRoot or not Util.IsAlive(target) then
			return
		end
		if (targetRoot.Position - npc.Root.Position).Magnitude <= cfg.AttackRange + 2 then
			CombatService.DealDamage(npc.Model, target, cfg.Damage * (npc.Enraged and 1.25 or 1), {
				Source = "melee",
				Element = npc.Element,
				Knockback = cfg.IsBoss == true,
			})
		end
	end)
end

local function slam(npc: NPC)
	local cfg = npc.Config
	npc.LastSlam = os.clock()
	npc.Slamming = true
	npc.Humanoid:MoveTo(npc.Root.Position)
	local groundY = npc.Root.Position.Y - ((npc.Model:GetAttribute("SpawnHeight") :: number?) or 3)
	local center = Vector3.new(npc.Root.Position.X, groundY, npc.Root.Position.Z)

	Remotes.Effect:FireAllClients({
		Type = "Telegraph",
		Position = center,
		Radius = cfg.SlamRadius,
		Duration = cfg.SlamWarning,
	})
	if npc.Tracks.Lunge then
		npc.Tracks.Lunge:Play(0.1, 1, 0.6)
	end

	task.delay(cfg.SlamWarning, function()
		npc.Slamming = false
		if npc.Humanoid.Health <= 0 then
			return
		end
		Remotes.Effect:FireAllClients({
			Type = "Ring",
			Position = center,
			Radius = cfg.SlamRadius,
			Color = Color3.fromRGB(230, 30, 50),
			Element = "void",
		})
		playWeaponSound(npc.Model, "Lunge")
		for _, target in CombatService.QueryRadius(center, cfg.SlamRadius, { npc.Model }) do
			if Players:GetPlayerFromCharacter(target) then
				CombatService.DealDamage(npc.Model, target, cfg.SlamDamage, {
					Source = "slam",
					Knockback = true,
				})
			end
		end
	end)
end

local function think(npc: NPC, dt: number)
	local humanoid, root, cfg = npc.Humanoid, npc.Root, npc.Config
	if humanoid.Health <= 0 or not root.Parent then
		return
	end
	if npc.Slamming then
		return
	end
	if CombatService.IsStunned(npc.Model) then
		humanoid:MoveTo(root.Position)
		return
	end

	local fromHome = (root.Position - npc.Home).Magnitude

	-- Voltando para casa (perdeu o alvo / foi longe demais)
	if fromHome > cfg.LeashRange then
		npc.Returning = true
		npc.Target = nil
	end
	if npc.Returning then
		humanoid:MoveTo(npc.Home)
		if fromHome < 8 then
			npc.Returning = false
			humanoid.Health = humanoid.MaxHealth
			table.clear(npc.Damage)
		end
		return
	end

	if not isValidTarget(npc, npc.Target) then
		npc.Target = findTarget(npc)
	end
	local target = npc.Target

	if not target then
		-- Passeia perto de casa
		if os.clock() >= npc.NextWander then
			npc.NextWander = os.clock() + 4 + math.random() * 5
			local angle = math.random() * math.pi * 2
			local distance = math.random() * 12
			humanoid:MoveTo(npc.Home + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance))
		end
		-- Recupera vida fora de combate
		if humanoid.Health < humanoid.MaxHealth then
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + humanoid.MaxHealth * 0.05 * dt)
		end
		return
	end

	local targetRoot = Util.GetRoot(target) :: BasePart
	local offset = targetRoot.Position - root.Position
	local distance = offset.Magnitude

	if cfg.IsBoss and os.clock() - npc.LastSlam >= cfg.SlamInterval and distance < cfg.SlamRadius + 6 then
		slam(npc)
		return
	end

	if distance > cfg.AttackRange then
		humanoid:MoveTo(targetRoot.Position)
		-- Pula se ficar preso
		if root.AssemblyLinearVelocity.Magnitude < 1 then
			npc.StuckTime += dt
			if npc.StuckTime > 1 then
				humanoid.Jump = true
				npc.StuckTime = 0
			end
		else
			npc.StuckTime = 0
		end
	else
		humanoid:MoveTo(root.Position)
		local look = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
		if (look - root.Position).Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(root.Position, look)
		end
		local cooldown = cfg.AttackCooldown * (npc.Enraged and 0.75 or 1)
		if os.clock() - npc.LastAttack >= cooldown then
			attack(npc, target)
		end
	end
end

--------------------------------------------------------------------------
-- Bonecos de treino
--------------------------------------------------------------------------
local function setupDummy(dummy: Model)
	local humanoid = dummy:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local backup = dummy:Clone()
	local parent = dummy.Parent
	local lastHit = 0
	local lastHealth = humanoid.Health

	NPCService.CreateBillboard(dummy, "Boneco de Treino", false)

	humanoid.HealthChanged:Connect(function(health)
		if health < lastHealth then
			lastHit = os.clock()
		end
		lastHealth = health
	end)

	humanoid.Died:Connect(function()
		task.delay(2, function()
			local clone = backup:Clone()
			dummy:Destroy()
			clone.Parent = parent
			setupDummy(clone)
		end)
	end)

	task.spawn(function()
		while dummy.Parent and humanoid.Health > 0 do
			if os.clock() - lastHit > 3 and humanoid.Health < humanoid.MaxHealth then
				humanoid.Health = humanoid.MaxHealth
			end
			task.wait(0.5)
		end
	end)
end

--------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------
function NPCService.Init(services)
	CombatService = services.CombatService
	DataService = services.DataService
	ZoneService = services.ZoneService

	local existing = workspace:FindFirstChild("NPCs")
	if existing and existing:IsA("Folder") then
		npcFolder = existing
	else
		npcFolder = Instance.new("Folder")
		npcFolder.Name = "NPCs"
		npcFolder.Parent = workspace
	end

	-- Quem bate num NPC vira o alvo dele / conta para o chefe
	table.insert(CombatService.DamageListeners, function(target, attackerPlayer, amount)
		local npc = npcs[target]
		if not npc or not attackerPlayer then
			return
		end
		npc.Damage[attackerPlayer] = (npc.Damage[attackerPlayer] or 0) + amount
		if attackerPlayer.Character and isValidTarget(npc, attackerPlayer.Character) then
			npc.Target = attackerPlayer.Character
		end
	end)

	for _, dummy in CollectionService:GetTagged("Dummy") do
		if dummy:IsA("Model") then
			setupDummy(dummy)
		end
	end

	local spawnFolder = workspace:WaitForChild("NPCSpawns")
	for _, spawnPart in spawnFolder:GetChildren() do
		if spawnPart:IsA("BasePart") and spawnPart:GetAttribute("NPC") then
			task.spawn(spawnNPC, spawnPart:GetAttribute("NPC"), spawnPart, nil)
		end
	end

	Players.PlayerAdded:Connect(function(player)
		task.delay(3, function()
			if activeBoss and player.Parent then
				sendBossBar(activeBoss, player)
			end
		end)
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < THINK_INTERVAL then
			return
		end
		local step = accumulator
		accumulator = 0
		for _, npc in npcs do
			local ok, err = pcall(think, npc, step)
			if not ok then
				warn("[NPCService] " .. tostring(err))
			end
		end
	end)
end

return NPCService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3212">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[--[[
	PlayerService
	Cuida do jogador: entrar/sair, nascer com a espada equipada,
	vida por nível, abates, sequência de abates (recompensa pela cabeça)
	e o feed de abates.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SwordsFolder = ReplicatedStorage:WaitForChild("Swords")

local DataService
local CombatService

local PlayerService = {}

local function removeSwords(player: Player): boolean
	local wasEquipped = false
	local containers: { Instance } = {}
	if player.Character then
		table.insert(containers, player.Character)
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		table.insert(containers, backpack)
	end
	for _, container in containers do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("SwordId") then
				if container == player.Character then
					wasEquipped = true
				end
				child:Destroy()
			end
		end
	end
	return wasEquipped
end

-- Dá ao jogador a espada que ele tem equipada (nos dados)
function PlayerService.GiveSword(player: Player, forceEquip: boolean?)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local template = SwordsFolder:FindFirstChild(data.Equipped) or SwordsFolder:FindFirstChild(Config.DefaultSword)
	if not template then
		warn("[PlayerService] Espada não encontrada: " .. tostring(data.Equipped))
		return
	end
	CombatService.SetBlocking(player, false)
	local wasEquipped = removeSwords(player)
	local backpack = player:WaitForChild("Backpack", 5)
	if not backpack then
		return
	end
	local tool = template:Clone() :: Tool
	local sword = Config.SwordById[template.Name]
	if sword then
		tool.Name = sword.Name
	end
	tool.Equipped:Connect(function()
		local handle = tool:FindFirstChild("Handle")
		local sound = handle and handle:FindFirstChild("Unsheath")
		if sound and sound:IsA("Sound") then
			sound:Play()
		end
	end)
	tool.Parent = backpack

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 and (wasEquipped or forceEquip) then
		humanoid:EquipTool(tool)
	end
end

local function onPlayerDied(player: Player, humanoid: Humanoid)
	local data = DataService.Get(player)
	DataService.Increment(player, "Deaths", 1)
	local victimStreak = (player:GetAttribute("Streak") :: number?) or 0
	player:SetAttribute("Streak", 0)

	local hit = CombatService.GetLastAttacker(humanoid)
	local killerName = hit and hit.Name or nil
	local killer: Player? = hit and hit.Player or nil
	local R = Config.Rewards

	if killer and killer ~= player and killer.Parent then
		DataService.Increment(killer, "Kills", 1)
		local streak = ((killer:GetAttribute("Streak") :: number?) or 0) + 1
		killer:SetAttribute("Streak", streak)

		local victimLevel = data and data.Level or 1
		local xp = R.PlayerKillXP + victimLevel * R.PlayerKillXPPerLevel
		local coins = R.PlayerKillCoins + victimLevel * R.PlayerKillCoinsPerLevel + victimStreak * R.BountyPerStreak
		DataService.AddCoins(killer, coins)
		DataService.AddXP(killer, xp)

		Remotes.Notify:FireClient(killer, {
			Small = true,
			Text = ("+%d moedas   +%d XP"):format(coins, xp),
			Sub = "Você derrotou " .. player.DisplayName,
			Color = { 255, 215, 80 },
		})

		if R.StreakAnnounce[streak] then
			Remotes.Notify:FireAllClients({
				Text = killer.DisplayName .. " ESTÁ IMPARÁVEL!",
				Sub = streak .. " abates seguidos - derrote-o para ganhar a recompensa!",
				Color = { 255, 120, 60 },
			})
		end
		if victimStreak >= 3 then
			Remotes.Notify:FireAllClients({
				Small = true,
				Text = killer.DisplayName .. " encerrou a sequência de " .. player.DisplayName,
				Sub = ("Recompensa: +%d moedas"):format(victimStreak * R.BountyPerStreak),
				Color = { 255, 200, 90 },
			})
		end
	end

	Remotes.KillFeed:FireAllClients({
		Killer = killerName,
		Victim = player.DisplayName,
		KillerIsPlayer = killer ~= nil,
	})

	Remotes.Notify:FireClient(player, {
		Text = "VOCÊ CAIU",
		Sub = killerName and ("Derrotado por " .. killerName) or "Levante-se, guerreiro!",
		Color = { 255, 70, 70 },
	})
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	-- Espera os dados carregarem
	local start = os.clock()
	while not DataService.Get(player) and player.Parent and os.clock() - start < 15 do
		task.wait(0.1)
	end
	local data = DataService.Get(player)
	if not data or not player.Parent or player.Character ~= character then
		return
	end

	humanoid.MaxHealth = Config.MaxHealthForLevel(data.Level)
	humanoid.Health = humanoid.MaxHealth
	CombatService.ResetPlayer(player)

	humanoid.Died:Connect(function()
		onPlayerDied(player, humanoid)
	end)

	PlayerService.GiveSword(player, true)
end

local function onPlayerAdded(player: Player)
	player:SetAttribute("Streak", 0)
	player:SetAttribute("Zone", Config.DefaultZone)
	player:SetAttribute("Safe", true)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end

	DataService.Load(player)
end

function PlayerService.Init(services)
	DataService = services.DataService
	CombatService = services.CombatService

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		DataService.Release(player)
	end)
end

return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3213">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--[[
	ShopService
	Compra e equipamento de espadas (Ferraria da Vila).
	O cliente pede pelo RemoteFunction "Shop" e o servidor valida tudo.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataService
local PlayerService

local ShopService = {}

local function handleRequest(player: Player, action: any, swordId: any): (boolean, string)
	if type(action) ~= "string" or type(swordId) ~= "string" then
		return false, "Pedido inválido"
	end
	local sword = Config.SwordById[swordId]
	if not sword then
		return false, "Espada desconhecida"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "Seus dados ainda estão carregando"
	end

	if action == "Buy" then
		if data.Owned[swordId] then
			return false, "Você já possui esta espada"
		end
		if sword.Price == nil then
			return false, "Só pode ser obtida derrotando o Rei Caído"
		end
		if data.Level < sword.Level then
			return false, "Requer nível " .. sword.Level
		end
		if not DataService.SpendCoins(player, sword.Price) then
			return false, "Moedas insuficientes"
		end
		DataService.AddOwned(player, swordId)
		DataService.SetEquipped(player, swordId)
		PlayerService.GiveSword(player, true)
		return true, "Você comprou " .. sword.Name .. "!"
	elseif action == "Equip" then
		if not data.Owned[swordId] then
			return false, "Você não possui esta espada"
		end
		DataService.SetEquipped(player, swordId)
		PlayerService.GiveSword(player, true)
		return true, sword.Name .. " equipada!"
	end
	return false, "Ação desconhecida"
end

function ShopService.Init(services)
	DataService = services.DataService
	PlayerService = services.PlayerService

	Remotes.Shop.OnServerInvoke = handleRequest

	local function hookPrompt(prompt: Instance)
		if prompt:IsA("ProximityPrompt") then
			prompt.Triggered:Connect(function(player)
				Remotes.OpenShop:FireClient(player)
			end)
		end
	end
	for _, prompt in CollectionService:GetTagged("ShopPrompt") do
		hookPrompt(prompt)
	end
	CollectionService:GetInstanceAddedSignal("ShopPrompt"):Connect(hookPrompt)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3214">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[--[[
	WorldService
	- Placar "Top do Servidor" na Vila
	- Ciclo de dia e noite
	- Tochas que acendem à noite
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldService = {}

local function updateLeaderboards()
	local list = {}
	for _, player in Players:GetPlayers() do
		table.insert(list, {
			Name = player.DisplayName,
			Kills = player:GetAttribute("Kills") or 0,
			Level = player:GetAttribute("Level") or 1,
		})
	end
	table.sort(list, function(a, b)
		if a.Kills == b.Kills then
			return a.Level > b.Level
		end
		return a.Kills > b.Kills
	end)

	for _, board in CollectionService:GetTagged("Leaderboard") do
		local rows = board:FindFirstChild("Rows", true)
		if not rows then
			continue
		end
		for i = 1, 10 do
			local row = rows:FindFirstChild("Row" .. i)
			if row and row:IsA("TextLabel") then
				local entry = list[i]
				if entry then
					row.Text = ("%d. %s  -  %d abates  (Nv.%d)"):format(i, entry.Name, entry.Kills, entry.Level)
				else
					row.Text = ("%d. ---"):format(i)
				end
			end
		end
	end
end

local function setTorches(lit: boolean)
	for _, torch in CollectionService:GetTagged("NightLight") do
		if torch:IsA("Light") then
			torch.Enabled = lit
		elseif torch:IsA("BasePart") then
			torch.Material = lit and Enum.Material.Neon or Enum.Material.SmoothPlastic
		end
	end
end

function WorldService.Init()
	task.spawn(function()
		while true do
			updateLeaderboards()
			task.wait(5)
		end
	end)

	-- Ciclo dia/noite
	local hoursPerSecond = 24 / (Config.DayLengthMinutes * 60)
	local wasNight = nil
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 1 then
			return
		end
		Lighting.ClockTime = (Lighting.ClockTime + elapsed * hoursPerSecond) % 24
		elapsed = 0
		local isNight = Lighting.ClockTime < 6.3 or Lighting.ClockTime > 17.7
		if isNight ~= wasNight then
			wasNight = isNight
			setTorches(isNight)
		end
	end)
end

return WorldService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3215">
        <Properties>
          <string name="Name">ZoneService</string>
          <string name="Source"><![CDATA[--[[
	ZoneService
	Descobre em qual zona do mapa cada jogador está (Vila, Arena, Floresta...)
	As zonas são peças invisíveis dentro de Workspace.Zones com o atributo
	"Zone" (nome) e "Safe" (true = sem PvP).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local ZoneService = {}

local zoneParts: { BasePart } = {}

local function pointInPart(part: BasePart, point: Vector3): boolean
	local localPoint = part.CFrame:PointToObjectSpace(point)
	local half = part.Size / 2
	return math.abs(localPoint.X) <= half.X and math.abs(localPoint.Y) <= half.Y and math.abs(localPoint.Z) <= half.Z
end

function ZoneService.GetZoneAt(position: Vector3): (string, boolean)
	for _, part in zoneParts do
		if pointInPart(part, position) then
			return part:GetAttribute("Zone") or Config.DefaultZone, part:GetAttribute("Safe") == true
		end
	end
	return Config.DefaultZone, false
end

function ZoneService.IsSafe(player: Player): boolean
	return player:GetAttribute("Safe") == true
end

function ZoneService.IsPositionSafe(position: Vector3): boolean
	local _, safe = ZoneService.GetZoneAt(position)
	return safe
end

function ZoneService.Init()
	local folder = workspace:WaitForChild("Zones")
	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") then
			table.insert(zoneParts, child)
		end
	end
	-- zonas menores primeiro (para zonas dentro de zonas)
	table.sort(zoneParts, function(a, b)
		return a.Size.Magnitude < b.Size.Magnitude
	end)

	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					local zone, safe = ZoneService.GetZoneAt(root.Position)
					if player:GetAttribute("Zone") ~= zone then
						player:SetAttribute("Zone", zone)
					end
					if player:GetAttribute("Safe") ~= safe then
						player:SetAttribute("Safe", safe)
					end
				end
			end
			task.wait(0.3)
		end
	end)
end

return ZoneService
]]></string>
        </Properties>
      </Item>
    </Item>
