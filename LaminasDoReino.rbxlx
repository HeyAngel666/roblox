		XP = 1200,
		Coins = 600,
		RespawnTime = 180,
		Sword = "reicaido",
		IsBoss = true,
		SlamDamage = 35,
		SlamRadius = 16,
		SlamInterval = 9,
		SlamWarning = 1.1,
		EnrageAt = 0.5, -- fase 2 com 50% de vida
		MinionKind = "Esqueleto",
		MinionCount = 2,
		DropSword = "reicaido",
		DropChance = 0.3,
		MinContribution = 0.05, -- precisa causar 5% do dano para ganhar recompensa
	},
}

--------------------------------------------------------------------------
-- ZONAS (nomes usados no mapa)
--------------------------------------------------------------------------
Config.Zones = {
	Vila = { DisplayName = "VILA", Subtitle = "Zona segura", Color = { 120, 230, 140 } },
	Arena = { DisplayName = "ARENA", Subtitle = "PvP liberado", Color = { 255, 90, 80 } },
	Floresta = { DisplayName = "FLORESTA SOMBRIA", Subtitle = "Monstros", Color = { 150, 220, 110 } },
	Ruinas = { DisplayName = "RUÍNAS DO REI", Subtitle = "Chefe", Color = { 230, 60, 70 } },
	Campos = { DisplayName = "CAMPOS", Subtitle = "PvP liberado", Color = { 240, 220, 140 } },
}
Config.DefaultZone = "Campos"

--------------------------------------------------------------------------
-- MUNDO
--------------------------------------------------------------------------
Config.DayLengthMinutes = 12 -- duração de um dia completo no jogo

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3010">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--[[
	Funções utilitárias compartilhadas (servidor e cliente)
]]

local Util = {}

function Util.Color(rgb: { number }): Color3
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

-- Formata número com separador de milhar: 12500 -> "12.500"
function Util.FormatNumber(value: number): string
	local text = tostring(math.floor(value))
	local result = text:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if result:sub(1, 1) == "." then
		result = result:sub(2)
	end
	return result
end

-- Encontra o modelo (personagem/NPC) que possui Humanoid a partir de uma peça
function Util.GetCharacterFromPart(part: Instance): Model?
	local current = part.Parent
	while current and current ~= workspace do
		if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
			return current
		end
		current = current.Parent
	end
	return nil
end

function Util.GetHumanoid(model: Instance?): Humanoid?
	if not model then
		return nil
	end
	return model:FindFirstChildOfClass("Humanoid")
end

function Util.GetRoot(model: Instance?): BasePart?
	if not model then
		return nil
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function Util.IsAlive(model: Instance?): boolean
	local humanoid = Util.GetHumanoid(model)
	return humanoid ~= nil and humanoid.Health > 0 and Util.GetRoot(model) ~= nil
end

return Util
]]></string>
        </Properties>
      </Item>
